#!/usr/bin/env python3
"""Python Debugger Visual — VS Code style, Flask backend"""

from flask import Flask, render_template_string, request, jsonify
import sys, ast as _ast, builtins as _builtins, math as _math, copy as _copy
import multiprocessing as _mp, queue as _queue_mod, time as _time
import subprocess as _subprocess, tempfile as _tempfile, json as _json, shutil as _shutil, os as _os

# Force a non-interactive backend BEFORE any user code can import matplotlib.
# Without this, a user's plt.show() opens (or tries to open) a GUI window and
# blocks the request thread forever — the browser just sits on "Analizando…"
# with no way to recover. Agg makes show()/FuncAnimation no-ops: the plotting
# calls still run (so class/data logic still traces normally) but nothing
# tries to actually render a window this web debugger can't display anyway.
try:
    import matplotlib as _mpl
    _mpl.use('Agg', force=True)
except ImportError:
    pass

app = Flask(__name__)
app.json.sort_keys = False  # preserve dict insertion order in JSON responses
_BUILTIN_NAMES = set(dir(_builtins))
MAX_STEPS = 2000
EXEC_TIMEOUT_SECS = 12  # wall-clock safety net for blocking calls MAX_STEPS can't catch
                        # (time.sleep(), a stuck join(), network I/O, a GUI call that
                        # still blocks despite Agg, etc.)

# ── Reto de código: explicación de errores con Claude Code (headless) ──
# Usa la suscripción de Claude Code (claude -p, misma sesión OAuth de la CLI)
# en vez de una API key medida por token — así el alumno no paga aparte.
# CLAUDE_CODE_EXECPATH lo exporta la propia CLI cuando está instalada; si no
# está, caemos a "claude" y confiamos en el PATH.
CLAUDE_BIN = _os.environ.get('CLAUDE_CODE_EXECPATH') or _shutil.which('claude') or 'claude'
CLAUDE_EXPLAIN_TIMEOUT_SECS = 30
CLAUDE_EXPLAIN_MODEL = 'claude-haiku-4-5-20251001'  # rápido y barato, de sobra para una pista corta
# Carpeta de trabajo aislada y vacía para el subproceso: sin esto, la CLI
# auto-descubriría el CLAUDE.md/memoria de ESTE proyecto y los inyectaría en
# cada llamada, disparando el consumo de tokens para una simple pista.
_CLAUDE_EXPLAIN_CWD = _tempfile.mkdtemp(prefix='pyviz_ai_')

CLAUDE_TUTOR_SYSTEM_PROMPT = (
    "Eres un profesor de Python que corrige el intento de un alumno en un "
    "ejercicio guiado. Te paso el error de Python y unas pocas líneas de "
    "código alrededor de la línea que falló (no el archivo completo). "
    "Responde SIEMPRE en español, sin markdown, en como máximo 4 líneas, "
    "con este formato exacto:\n"
    "CAUSA: <por qué falla, una frase corta>\n"
    "LINEA: <qué está mal específicamente en esa línea>\n"
    "SOLUCION: <cómo arreglarlo, con el cambio de código concreto>\n"
    "No repitas el traceback ni saludes ni agregues nada fuera de esas 3 líneas."
)


def _json_safe(o):
    """Recursively replace JSON-invalid values (NaN, Infinity) with readable
    string sentinels so the browser's strict JSON.parse never chokes."""
    if isinstance(o, float):
        if _math.isnan(o): return 'NaN'
        if _math.isinf(o): return 'Infinity' if o > 0 else '-Infinity'
        return o
    if isinstance(o, dict):
        return {k: _json_safe(v) for k, v in o.items()}
    if isinstance(o, list):
        return [_json_safe(v) for v in o]
    if isinstance(o, tuple):
        return [_json_safe(v) for v in o]
    return o

# ── HTML ────────────────────────────────────────────────────────────────────
HTML = r'''<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Python Debugger</title>
<!-- CodeMirror (editor del "Reto de código" del Modo Maestro) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/lib/codemirror.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/theme/material-darker.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/addon/hint/show-hint.min.css">
<script src="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/lib/codemirror.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/mode/python/python.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/addon/hint/show-hint.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/addon/hint/anyword-hint.min.js"></script>
<!-- KaTeX (renderizado de fórmulas del Modo Maestro Matemáticas) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>
<style>
/* ── Reset & base ───────────────────────────────── */
*{margin:0;padding:0;box-sizing:border-box;}
html,body{height:100%;overflow:hidden;background:#1e1e1e;color:#d4d4d4;
  font-family:'Segoe UI',system-ui,sans-serif;font-size:13px;}

/* ── Layout ─────────────────────────────────────── */
.root{display:flex;flex-direction:column;height:100vh;}
header{height:36px;background:#323233;display:flex;align-items:center;
  padding:0 14px;gap:14px;border-bottom:1px solid #111;flex-shrink:0;}
.main{display:flex;flex:1;min-height:0;overflow:hidden;position:relative;}
.ctrl{height:38px;background:#2d2d30;display:flex;align-items:center;
  padding:0 10px;gap:6px;border-top:1px solid #111;flex-shrink:0;}

/* ── Header elements ─────────────────────────────── */
.hbrand{font-weight:700;font-size:14px;color:#e0e0e0;}
.hsel{background:#3c3c3c;color:#ccc;border:1px solid #555;padding:3px 8px;
  border-radius:3px;font-size:12px;cursor:pointer;}
.hhint{margin-left:auto;font-size:11px;color:#777;}

/* ── Panels: 2 columnas (Código | Explicabilidad) ── */
.p-code    {flex:1;min-width:340px;border-right:1px solid #3e3e42;display:flex;flex-direction:column;}
.code-body {flex:1;display:flex;min-height:0;overflow:hidden;position:relative;}
.p-right   {flex:1.05;min-width:380px;display:flex;flex-direction:column;}
/* edit ↔ run toggle button in the code title bar */
.edit-btn{margin-left:auto;background:#2d4a30;border:1px solid #3e7a45;color:#9fe0a8;
  font-size:11px;padding:2px 9px;border-radius:4px;cursor:pointer;transition:background .15s;}
.edit-btn:hover{background:#3a5e3d;}

.ptitle{height:30px;background:#252526;border-bottom:1px solid #3e3e42;
  display:flex;align-items:center;padding:0 10px;font-size:11px;
  color:#bbb;flex-shrink:0;gap:8px;}
.ptitle-py{background:#1e3a2f;}
.ptitle-fr{background:#5d2d6b;color:#eee;}
.ptitle-ob{background:#3b2d5d;color:#eee;}
.ptitle-out{background:#1a1a30;}
.ptitle-exp{background:#231a3a;color:#cdb8f0;}

/* ── Editor area ─────────────────────────────────── */
.ed-body{display:flex;flex:1;overflow:hidden;}
#lineNums{width:44px;background:#252526;overflow:hidden;padding:4px 0;
  text-align:right;flex-shrink:0;border-right:1px solid #3e3e42;
  font-family:'Courier New',monospace;font-size:12px;line-height:21px;color:#858585;}
.ln-row{height:21px;line-height:21px;padding-right:8px;cursor:pointer;
  position:relative;user-select:none;transition:color .1s;}
.ln-row:hover{color:#ddd;}
.ln-row.has-bp{color:#e81828;}
.bp-dot{position:absolute;left:3px;top:50%;transform:translateY(-50%);
  width:8px;height:8px;background:#e81828;border-radius:50%;
  animation:bp-pop .15s ease-out;}
#codeInput{flex:1;background:#1e1e1e;color:#d4d4d4;border:none;outline:none;
  resize:none;font-family:'Cascadia Code','Courier New',monospace;
  font-size:13px;line-height:21px;padding:4px 8px;tab-size:4;}
#codeInput::placeholder{color:#3d3d3d;}

/* ── Narrator (line explanation) ─────────────────── */
.narrator{display:flex;flex-direction:column;gap:4px;padding:7px 12px;
  background:linear-gradient(90deg,#1b2438,#171b2b);
  border-bottom:1px solid #2a3552;border-left:3px solid #3a7bd5;
  font-size:12.5px;line-height:1.35;color:#cdd6e8;flex-shrink:0;
  min-height:34px;overflow:hidden;
  transition:border-left-color .3s,background .3s;}
.nar-main{display:flex;align-items:center;gap:9px;}
.narrator-idle{border-left-color:#444;color:#777;
  background:linear-gradient(90deg,#1a1a22,#181820);}
.nar-ico{font-size:16px;flex-shrink:0;line-height:1;
  display:inline-flex;align-items:center;justify-content:center;width:22px;}
.nar-txt{flex:1;min-width:0;}
.nar-txt b,.nar-txt .nar-var{color:#7ec5ff;font-weight:600;font-family:'Cascadia Code',monospace;}
.nar-step{margin-left:auto;flex-shrink:0;font-size:10px;color:#5a6a8a;
  font-family:monospace;background:#0d1322;padding:2px 7px;border-radius:10px;}
/* breakdown + effect detail block */
.nar-detail{display:flex;flex-direction:column;gap:2px;padding-left:31px;}
.nar-detail:empty{display:none;}
.nar-ev{font-family:'Cascadia Code',monospace;font-size:11px;color:#8fa6c4;
  animation:nar-slide .3s ease-out;}
.nar-ev .ev-expr{color:#b9c7dc;}
.nar-ev .ev-arrow{color:#5a6a8a;margin:0 3px;}
.nar-ev .ev-val{color:#6cc8a0;font-weight:700;}
.nar-fx{font-family:'Cascadia Code',monospace;font-size:11px;margin-top:2px;
  animation:nar-slide .3s ease-out;}
.nar-fx b{font-weight:700;}
.nar-fx-new{color:#7ddf9a;}
.nar-fx-chg{color:#e6c46a;}
.nar-fx-out{color:#9aa6c0;}
.narrator.nar-flash .nar-ico{animation:nar-pop .4s cubic-bezier(.34,1.56,.64,1);}
.narrator.nar-flash .nar-txt{animation:nar-slide .32s ease-out;}
@keyframes nar-pop{0%{transform:scale(.4) rotate(-12deg);opacity:.3;}
  60%{transform:scale(1.25) rotate(4deg);}100%{transform:scale(1) rotate(0);opacity:1;}}
@keyframes nar-slide{0%{opacity:0;transform:translateX(-10px);}
  100%{opacity:1;transform:translateX(0);}}
/* kind accent colors */
.nar-k-assign  {border-left-color:#3a7bd5;}
.nar-k-augassign{border-left-color:#3a7bd5;}
.nar-k-loop    {border-left-color:#e0913a;}
.nar-k-cond    {border-left-color:#d35db0;}
.nar-k-print   {border-left-color:#46a758;}
.nar-k-def     {border-left-color:#9b6dd6;}
.nar-k-class   {border-left-color:#9b6dd6;}
.nar-k-return  {border-left-color:#46a758;}
.nar-k-import  {border-left-color:#6b7280;}
.nar-k-call,.nar-k-method,.nar-k-expr{border-left-color:#4a9eb8;}
.nar-k-assert,.nar-k-raise{border-left-color:#d14b4b;}
.nar-k-break,.nar-k-continue,.nar-k-pass{border-left-color:#e0913a;}
.nar-k-with,.nar-k-try,.nar-k-except{border-left-color:#c9a13b;}
.nar-k-yield{border-left-color:#46a758;}
.nar-k-del,.nar-k-global{border-left-color:#6b7280;}
.nar-k-done{border-left-color:#46a758;background:linear-gradient(90deg,#16291c,#141f18);color:#9fdcae;}

/* ── Executor area ───────────────────────────────── */
.exec-scroll{flex:1;overflow-y:auto;overflow-x:auto;padding:4px 0;}
.er{display:flex;align-items:center;height:21px;padding:0 8px;
  font-family:'Cascadia Code','Courier New',monospace;font-size:13px;
  white-space:nowrap;transition:background .2s;}
.er.r-prev{background:rgba(255,255,255,.04);}
.er.r-next{background:rgba(244,135,113,.1);box-shadow:inset 3px 0 0 #f48771;
  animation:er-sweep .4s ease-out;}
@keyframes er-sweep{
  0%  {background:rgba(244,135,113,.34);box-shadow:inset 3px 0 0 #f48771,0 0 12px rgba(244,135,113,.4);}
  100%{background:rgba(244,135,113,.1); box-shadow:inset 3px 0 0 #f48771,0 0 0 rgba(244,135,113,0);}}
.er.r-bp  {background:rgba(232,24,40,.08);}
.eln{min-width:36px;text-align:right;color:#858585;margin-right:8px;
  font-size:12px;flex-shrink:0;}
.earr{width:16px;flex-shrink:0;margin-right:6px;}
/* preserve Python indentation exactly (don't collapse leading spaces/tabs) */
.ecode{white-space:pre;tab-size:4;-moz-tab-size:4;}
.ap{color:#666;}
.an{color:#f48771;}

/* ── Syntax colors ───────────────────────────────── */
.kw{color:#c586c0;}.str{color:#ce9178;}.num{color:#4ec9b0;}
.cmt{color:#6a9955;}.bi{color:#dcdcaa;}.op{color:#d4d4d4;}

/* ── Right panel ─────────────────────────────────── */
.out-wrap{display:flex;flex-direction:column;overflow:hidden;transition:height .28s cubic-bezier(.4,0,.2,1);}
.out-body-old{display:none;}

.h-drag{height:6px;background:#3c3c3c;cursor:row-resize;flex-shrink:0;
  border-top:1px solid #555;border-bottom:1px solid #555;}
.h-drag:hover{background:#c77dbb;}

.bot-wrap{flex:1;display:flex;min-height:0;position:relative;}
/* ── Relation arrows SVG overlay ── */
#relArrows{position:absolute;top:0;left:0;width:100%;height:100%;
  pointer-events:none;z-index:20;overflow:visible;}
/* faint static "cable" under the animated dashes */
.rel-base{stroke:rgba(199,125,187,.18);stroke-width:4;fill:none;stroke-linecap:round;}
.rel-path{stroke:#c77dbb;stroke-width:2.5;fill:none;stroke-dasharray:7 5;stroke-linecap:round;
  animation:dash-flow 1s linear infinite;
  filter:drop-shadow(0 0 4px rgba(199,125,187,.55));}
@keyframes dash-flow{from{stroke-dashoffset:36}to{stroke-dashoffset:0}}
.rel-head{fill:#e59ad6;filter:drop-shadow(0 0 5px rgba(199,125,187,.8));}
.rel-dot{fill:none;stroke:#c77dbb;stroke-width:2;
  animation:rel-pulse 1s ease-in-out infinite;}
@keyframes rel-pulse{0%,100%{r:4;opacity:1}50%{r:7;opacity:.35}}
/* traveling particle that flows source → target (data binding) */
.rel-particle{fill:#fff;filter:drop-shadow(0 0 6px #e59ad6);}
.rel-particle-glow{fill:#e59ad6;opacity:.5;}
/* relationship label badge at curve midpoint */
.rel-label-bg{fill:#241430;stroke:#6a3d8a;stroke-width:1;rx:7;
  filter:drop-shadow(0 1px 3px rgba(0,0,0,.6));}
.rel-label-tx{fill:#e0b3d8;font:700 10px 'Cascadia Code',monospace;
  dominant-baseline:central;text-anchor:middle;}
/* ── Link badge in Frames ── */
.vw-link{display:inline-flex;align-items:center;gap:2px;font-size:9px;
  padding:1px 5px 1px 3px;border-radius:9px;
  background:linear-gradient(90deg,#1e0f2e,#2a1040);
  border:1px solid #5a3080;color:#c77dbb;margin-left:4px;
  font-family:monospace;flex-shrink:0;animation:wg-new .35s ease-out;}
.vw-link-arr{font-size:12px;color:#9b8fff;}
/* ── Active index in Objects (list cell) ── */
.ob-cell-act{
  border:1.5px solid #c77dbb !important;
  box-shadow:0 0 12px rgba(199,125,187,.55);
  position:relative;z-index:2;}
.ob-cell-act::after{content:'▲';position:absolute;bottom:-17px;left:50%;
  transform:translateX(-50%);color:#c77dbb;font-size:10px;line-height:1;
  animation:ptr-bob .55s ease infinite alternate;}
@keyframes ptr-bob{from{transform:translateX(-50%) translateY(0)}to{transform:translateX(-50%) translateY(4px)}}
/* ── Active row in Objects (dict table) ── */
.ob-tr-act td{background:rgba(199,125,187,.12)!important;}
.ob-tr-act td:first-child{border-left:3px solid #c77dbb;}
.fr-wrap{flex:1;display:flex;flex-direction:column;overflow:hidden;
  border-right:1px solid #3e3e42;}
.ob-wrap{flex:1.4;display:flex;flex-direction:column;overflow:hidden;
  background:#0e0e1c;transition:box-shadow .6s ease;}
.fr-body{flex:1;overflow-y:auto;padding:4px 0;background:#141422;}
.ob-body{flex:1;overflow-y:auto;padding:0;background:#0e0e1c;}

/* ── Frames variables ────────────────────────────── */
.fg-title{font-size:10px;font-weight:700;color:#c77dbb;padding:4px 8px 2px;
  text-transform:uppercase;letter-spacing:.5px;}
.vr{display:flex;align-items:center;padding:2px 8px;border-radius:3px;
  font-family:'Courier New',monospace;font-size:12px;cursor:pointer;
  transition:background .12s;height:22px;}
.vr:hover{background:rgba(255,255,255,.07);}
.vr.vr-odd{background:rgba(255,255,255,.025);}
.vr.vr-odd:hover{background:rgba(255,255,255,.07);}
.vr.v-new    {animation:v-new .25s ease-out;}
.vr.v-changed{animation:v-changed .35s ease-out;}
.vname{color:#d4d4d4;min-width:70px;flex-shrink:0;}
.vsep {color:#555;margin:0 5px;}
.vnum {color:#4ec9b0;}.vstr{color:#ce9178;}.vbool{color:#569cd6;}
.vnone{color:#569cd6;}.vobj{color:#4ec9b0;}
.obtn{background:#3a2d50;border:1px solid #6a3d8a;color:#c77dbb;
  font-size:10px;padding:0 5px;border-radius:3px;cursor:pointer;
  margin-left:5px;line-height:18px;flex-shrink:0;}
.obtn:hover{background:#4a3d60;}

/* ── Objects panel ───────────────────────────────── */
.ob-ph{color:#555;font-style:italic;padding:14px 10px;font-size:11px;text-align:center;}
.ob-hdr{padding:6px 10px 4px;background:#1a1228;border-bottom:1px solid #3b2d5d;
  display:flex;align-items:center;gap:6px;}
.ob-hdr-name{color:#c77dbb;font-weight:800;font-family:monospace;font-size:13px;}
.ob-hdr-type{font-size:9px;padding:1px 6px;border-radius:8px;font-weight:800;}
.ob-hdr-cnt{color:#666;font-size:11px;margin-left:auto;}

/* list cells horizontal grid */
.ob-grid{display:flex;flex-wrap:wrap;gap:5px;padding:8px 8px 10px;background:#0f0f1e;}
.ob-cell{display:flex;flex-direction:column;border-radius:6px;overflow:hidden;
  border:1px solid #3b3470;min-width:52px;max-width:80px;
  animation:ob-pop .22s ease-out both;}
@keyframes ob-pop{
  0%  {opacity:0;transform:translateY(8px) scale(.85);}
  70% {transform:translateY(-2px) scale(1.04);}
  100%{opacity:1;transform:translateY(0) scale(1);}}
.ob-ci{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;
  font-size:10px;font-weight:800;padding:2px 4px;text-align:center;}
.ob-cv{font-family:monospace;font-size:12px;padding:4px 5px;
  text-align:center;background:#131323;word-break:break-all;}
.ob-cv.is-num{color:#4ec9b0;}
.ob-cv.is-str{color:#ce9178;}
.ob-cv.is-bool{color:#569cd6;}
.ob-ct{font-size:9px;color:#555;text-align:center;padding:1px 4px 3px;
  background:#0f0f1e;}
/* ── Value-change flash: highlights cells whose value differs from the
   previous animation frame — this is what makes stepping/looping through
   1D/2D/3D/4D data read as an animation instead of a static snapshot. */
@keyframes cell-flash{
  0%{box-shadow:0 0 0 3px rgba(255,196,0,.9);}
  100%{box-shadow:0 0 0 0 rgba(255,196,0,0);}}
@keyframes cell-flash-new{
  0%{box-shadow:0 0 0 3px rgba(90,220,120,.9);}
  100%{box-shadow:0 0 0 0 rgba(90,220,120,0);}}
/* A genuinely new/changed list value (no match found in the previous
   frame): pop in with a green flash. A value that just moved to a new
   index gets no flash at all — see _flipCells, it slides there instead. */
.ob-cell-new{animation:ob-pop .22s ease-out both, cell-flash-new 1.1s ease-out both;
  border-color:#5adc78!important;}
.ob-cell-new .ob-cv{color:#5adc78!important;}
.ob-cell[data-srcidx]{will-change:transform;}
@keyframes row-flash{0%{background:rgba(255,196,0,.32);}100%{background:transparent;}}
.ob-tr-diff td{animation:row-flash 1.1s ease-out both;}
.ob-tr-diff .ob-td-val{color:#ffc400!important;}

/* dict / set table */
.ob-table{width:100%;border-collapse:collapse;font-family:monospace;font-size:12px;}
.ob-table thead th{background:#1e1228;color:#c77dbb;font-size:10px;
  font-weight:800;padding:3px 8px;text-align:left;border-bottom:1px solid #3b2d5d;}
.ob-table tbody tr{animation:ob-pop .2s ease-out both;border-bottom:1px solid #1e1e2e;}
.ob-table tbody tr:hover{background:rgba(255,255,255,.04);}
.ob-table td{padding:4px 8px;vertical-align:middle;}
.ob-td-idx{color:#667eea;font-weight:700;font-size:11px;}
.ob-td-key{color:#ffd700;}
.ob-td-val{}
.ob-td-val.is-num{color:#4ec9b0;}
.ob-td-val.is-str{color:#ce9178;}
.ob-td-val.is-bool{color:#569cd6;}
.ob-td-typ{color:#555;font-size:9px;}
.ob-td-bin{font-family:monospace;font-size:9px;color:#7fb0e0;background:#0d1f33;
  border:1px solid #1f3a5a;border-radius:8px;padding:0 5px;margin-left:6px;}

/* ── Control bar ─────────────────────────────────── */
.ctrl button{padding:4px 12px;background:#0e639c;color:#fff;border:none;
  border-radius:3px;cursor:pointer;font-size:12px;transition:background .15s;}
.ctrl button:hover:not(:disabled){background:#1177bb;}
.ctrl button:disabled{opacity:.35;cursor:default;}
.btn-run{background:#388a34!important;}
.btn-run:hover:not(:disabled){background:#4aa640!important;}
.btn-last{min-width:72px;}
.btn-loop{min-width:80px;background:#7a3d9c!important;}
.btn-loop:hover:not(:disabled){background:#8f4ab5!important;}
.btn-loop.btn-looping{animation:loop-pulse 1.1s ease-in-out infinite;}
@keyframes loop-pulse{0%,100%{box-shadow:0 0 0 0 rgba(199,125,187,.55);}50%{box-shadow:0 0 0 6px rgba(199,125,187,0);}}
.loop-speed{background:#1e1e2e;color:#ccc;border:1px solid #3b3470;border-radius:3px;
  font-size:11px;padding:3px 4px;margin-left:2px;cursor:pointer;}
.cstatus{flex:1;font-size:12px;color:#aaa;margin:0 8px;}
.kbhint{font-size:10px;color:#555;}

/* ── Modo Maestro (temario guiado) ─────────────────── */
.master-bar{background:#241a33;border-bottom:2px solid #7a3d9c;flex-shrink:0;
  display:flex;flex-direction:column;}
.master-top{display:flex;align-items:center;gap:10px;padding:6px 14px;}
.master-title{font-size:12px;color:#d8b8f0;font-weight:600;white-space:nowrap;
  overflow:hidden;text-overflow:ellipsis;max-width:34%;}
.master-progress-track{flex:1;height:8px;background:#3a2a4d;border-radius:4px;overflow:hidden;}
.master-progress-fill{height:100%;width:0%;background:linear-gradient(90deg,#7a3d9c,#c77dbb);
  transition:width .3s ease;}
.master-pct{font-size:11px;color:#b89ad0;white-space:nowrap;}
.master-btn{padding:4px 10px;background:#4a2d63;color:#f0e0fa;border:none;
  border-radius:3px;cursor:pointer;font-size:11px;white-space:nowrap;transition:background .15s;}
.master-btn:hover:not(:disabled){background:#5c3a7a;}
.master-btn:disabled{opacity:.35;cursor:default;}
.master-btn-next{background:#388a34;}
.master-btn-next:hover{background:#4aa640;}
.master-btn-exit{background:transparent;color:#b89ad0;font-size:13px;padding:4px 8px;}
.master-btn-exit:hover{background:#4a2d63;}
.master-checklist{max-height:180px;overflow-y:auto;padding:6px 14px 10px;
  display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:4px;}
.master-item{display:flex;align-items:center;gap:8px;padding:4px 8px;border-radius:3px;
  background:#2f2140;cursor:pointer;font-size:11px;color:#cbb8de;transition:background .15s;}
.master-item:hover{background:#3a2a4d;}
.master-item-chk{min-width:16px;height:16px;display:flex;align-items:center;justify-content:center;
  font-size:10px;border-radius:50%;background:#4a2d63;color:#d8b8f0;flex-shrink:0;}
.master-item-done{color:#a0d8a0;}
.master-item-done .master-item-chk{background:#2e5c2e;color:#a0d8a0;}
.master-item-current{outline:1px solid #c77dbb;background:#3a2a4d;}
.master-item-name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}

/* Modo Maestro AO: mismo componente, acento verde/teal para distinguirlo a
   simple vista del Modo Maestro de Python (morado) — son dos temarios y dos
   progresos independientes que pueden estar guardados a la vez. */
.master-bar-ao{background:#132a26;border-bottom-color:#2f9e7a;}
.master-bar-ao .master-title{color:#a8f0d8;}
.master-bar-ao .master-progress-track{background:#1e4038;}
.master-bar-ao .master-progress-fill{background:linear-gradient(90deg,#1f7a5c,#4ecfa0);}
.master-bar-ao .master-pct{color:#8fd0b8;}
.master-bar-ao .master-btn{background:#1e4038;color:#d8f5ea;}
.master-bar-ao .master-btn:hover:not(:disabled){background:#295a4d;}
.master-bar-ao .master-btn-exit{color:#8fd0b8;}
.master-bar-ao .master-btn-exit:hover{background:#1e4038;}

/* Modo Maestro Matemáticas: mismo componente, acento azul — tercer temario
   guiado independiente (progreso propio en localStorage). */
.master-bar-math{background:#132539;border-bottom-color:#2f6f9e;}
.master-bar-math .master-title{color:#a8d8f0;}
.master-bar-math .master-progress-track{background:#1e3448;}
.master-bar-math .master-progress-fill{background:linear-gradient(90deg,#1f5c7a,#4eaacf);}
.master-bar-math .master-pct{color:#8fb8d0;}
.master-bar-math .master-btn{background:#1e3448;color:#d8ecf5;}
.master-bar-math .master-btn:hover:not(:disabled){background:#295a75;}
.master-bar-math .master-btn-exit{color:#8fb8d0;}
.master-bar-math .master-btn-exit:hover{background:#1e3448;}

/* Repaso mezclado: acento ámbar — 4º modo, sin temario secuencial propio
   (no tiene checklist ni barra de progreso, solo título + salir). */
.master-bar-review{background:#3a2b12;border-bottom-color:#a67a2e;}
.master-bar-review .master-title{color:#f0d8a8;}
.master-bar-review .master-pct{color:#d8b878;}
.master-bar-review .master-btn-exit{color:#d8b878;}
.master-bar-review .master-btn-exit:hover{background:#4a3818;}
.master-item-fails{font-size:9px;color:#e08a6a;margin-left:5px;font-weight:600;}

/* ── Modo Maestro Matemáticas: panel de estudio (sustituye a .main) ─── */
.math-panel{flex:1;min-height:0;overflow-y:auto;padding:16px 22px;
  display:flex;flex-direction:column;gap:16px;background:#1e1e1e;}
.math-card{background:#242430;border:1px solid #33334a;border-radius:6px;padding:14px 16px;}
.math-body{font-size:13px;line-height:1.6;color:#d4d4d4;margin-top:8px;}
.math-badge{font-size:10px;color:#8fb8d0;background:#1e3448;border-radius:3px;
  padding:2px 7px;margin-left:8px;font-weight:600;}
.math-worked-wrap{margin-top:12px;padding-top:10px;border-top:1px dashed #3a3a55;}
.math-worked-hdr{font-size:11px;color:#c9a8f0;font-weight:600;}
.math-worked{color:#c9c0dd;}
.math-options{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));
  gap:8px;margin-top:10px;}
.math-option{background:#2d2d3d;border:1px solid #3d3d55;border-radius:5px;padding:8px 12px;
  color:#d4d4d4;cursor:pointer;font-size:12.5px;text-align:left;transition:background .15s;}
.math-option:hover:not(:disabled){background:#37374a;}
.math-option:disabled{cursor:default;}
.math-option-correct{background:#1f4a2a!important;border-color:#3a8a4a!important;color:#c0f0c8!important;}
.math-option-wrong{background:#4a1f24!important;border-color:#8a3a42!important;color:#f0c0c4!important;}
.math-numeric-wrap{display:flex;gap:8px;margin-top:10px;align-items:center;}
.math-numeric-input{background:#1a1a24;border:1px solid #3d3d55;border-radius:4px;color:#e8e8e8;
  padding:7px 10px;font-size:13px;width:140px;}
.math-feedback{margin-top:10px;padding:8px 12px;border-radius:5px;font-size:12.5px;font-weight:600;}
.math-feedback-ok{background:#1f4a2a;color:#c0f0c8;}
.math-feedback-bad{background:#4a1f24;color:#f0c0c4;}
.math-aiwhy{margin-top:10px;padding:10px 12px;background:#2a2438;border-left:3px solid #9a6ad0;
  border-radius:4px;font-size:12.5px;color:#dcc8f0;}
.math-aiwhy-hdr{font-weight:600;color:#c9a8f0;margin-bottom:4px;font-size:11px;}
.math-solution{margin-top:10px;padding:10px 12px;background:#1e3448;border-radius:5px;}
.self-explain-block{margin-top:12px;}
.self-explain-block textarea{width:100%;min-height:60px;margin-top:6px;background:#1a1a24;
  border:1px solid #3d3d55;border-radius:4px;color:#e0e0e0;font-size:12px;padding:8px;
  font-family:inherit;resize:vertical;}
.self-explain-block p{font-size:12px;color:#b8a8d0;margin-bottom:2px;}
.ao-quiz-block{padding:8px 14px 12px;border-top:1px dashed #2f5a4d;}
.ao-quiz-hdr{font-size:11px;color:#8fd0b8;font-weight:600;margin-bottom:4px;}

/* ── Reto de código (modal del Modo Maestro) ─────────── */
.challenge-overlay{position:absolute;inset:0;z-index:50;pointer-events:none;}
.challenge-card{position:absolute;top:0;right:0;bottom:0;width:51.22%;min-width:380px;
  background:#241a33;border-left:1px solid #7a3d9c;border-radius:0;display:flex;flex-direction:column;
  box-shadow:-10px 0 40px rgba(0,0,0,.5);pointer-events:auto;}
.challenge-hdr{display:flex;align-items:center;justify-content:space-between;
  padding:12px 16px;border-bottom:1px solid #3a2a4d;font-size:14px;color:#f0e0fa;font-weight:600;flex-shrink:0;}
.challenge-prompt{padding:10px 16px 0;font-size:12px;color:#cbb8de;line-height:1.5;flex-shrink:0;}
.challenge-editor-wrap{margin:10px 16px;border:1px solid #3a2a4d;border-radius:4px;overflow:hidden;
  flex:1;min-height:0;display:flex;}
.challenge-editor-wrap .CodeMirror{height:100%;width:100%;font-size:13px;}
.challenge-status{padding:0 16px;font-size:12px;min-height:18px;white-space:pre-wrap;}
.challenge-status.ok{color:#7ec87e;}
.challenge-status.fail{color:#e08787;}
.challenge-hint,.challenge-solution,.challenge-diff{margin:0 16px 10px;padding:8px 10px;background:#2f2140;
  border-radius:4px;font-size:11px;color:#d8c8ea;white-space:pre-wrap;max-height:160px;overflow-y:auto;}
.challenge-diff{background:#3a1f24;color:#e0b0b0;border-left:3px solid #e08787;}
.challenge-ai{margin:0 16px 10px;padding:8px 10px;background:#1e2e3a;border-left:3px solid #5aa9e0;
  border-radius:4px;font-size:11px;color:#bfe0ff;white-space:pre-wrap;max-height:200px;overflow-y:auto;flex-shrink:0;}
.challenge-actions{display:flex;gap:6px;flex-wrap:wrap;padding:10px 16px 16px;flex-shrink:0;}
.challenge-actions .master-btn{padding:6px 12px;font-size:12px;}
.challenge-actions .master-btn:disabled{opacity:.4;cursor:not-allowed;}
/* Línea con error dentro del editor del Reto — igual que el subrayado rojo
   de un IDE, para que "Explícamelo" apunte al punto exacto sin ambigüedad. */
.challenge-editor-wrap .CodeMirror .cm-error-line{
  background:rgba(224,135,135,.18);border-left:3px solid #e08787;}
/* La lista de autocompletado de CodeMirror trae z-index:10 por defecto — el
   overlay del modal del Reto tiene z-index:50 y la tapaba por completo,
   así que el autocompletado nunca se veía aunque sí se disparaba. */
.CodeMirror-hints{z-index:10000!important;}

/* ── Animations ──────────────────────────────────── */
@keyframes v-new{
  0%  {opacity:0;background:rgba(39,174,96,.35);}
  60% {background:rgba(39,174,96,.1);}
  100%{opacity:1;background:transparent;}}
@keyframes v-changed{
  0%  {background:rgba(255,200,0,.55);}
  100%{background:transparent;}}
@keyframes bp-pop{
  0%  {transform:translateY(-50%) scale(0);}
  70% {transform:translateY(-50%) scale(1.4);}
  100%{transform:translateY(-50%) scale(1);}}
@keyframes line-pulse{
  0%,100%{background:rgba(244,135,113,.10);}
  50%    {background:rgba(244,135,113,.22);}}
.r-next{animation:line-pulse 1.2s ease-in-out infinite;}

/* ── Variable widgets ────────────────────────────── */
.vwidget{margin:4px 6px;border-radius:7px;border:1px solid #333;
  background:#1e1e2e;overflow:hidden;
  transition:border-color .25s,box-shadow .25s;}
.vwidget.v-new{
  animation:wg-new .4s ease-out;border-color:#27ae60;}
.vwidget.v-changed{
  animation:wg-changed .5s ease-out;}
@keyframes wg-new{
  0%  {opacity:0;transform:translateX(-12px);border-color:#27ae60;box-shadow:0 0 10px rgba(39,174,96,.45);}
  60% {opacity:1;transform:translateX(2px);}
  100%{transform:translateX(0);border-color:#333;box-shadow:none;}}
@keyframes wg-changed{
  0%  {border-color:#f39c12;box-shadow:0 0 12px rgba(243,156,18,.5);}
  60% {border-color:#f39c12;}
  100%{border-color:#333;box-shadow:none;}}

.vw-hdr{display:flex;align-items:center;gap:6px;padding:5px 8px;}
.vw-ico{font-size:15px;flex-shrink:0;line-height:1;}
.vw-nm {color:#d4d4d4;font-weight:700;font-family:'Cascadia Code','Courier New',monospace;
  font-size:12px;min-width:50px;}
.vw-ty {font-size:9px;padding:1px 5px;border-radius:8px;font-weight:800;
  letter-spacing:.3px;flex-shrink:0;}
.ty-int  {background:#0d3a47;color:#4ec9b0;}
.ty-flt  {background:#1a3a2a;color:#4fc3a1;}
.ty-str  {background:#3a1e0d;color:#ce9178;}
.ty-bool {background:#0d1a3a;color:#569cd6;}
.ty-none {background:#2a2a2a;color:#666;}
.ty-list {background:#1a1542;color:#9b8fff;}
.ty-dict {background:#2a1a00;color:#f0c060;}
.ty-set  {background:#1a2a1a;color:#80c080;}
.vw-val{font-family:'Cascadia Code','Courier New',monospace;font-size:12px;
  margin-left:auto;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100px;}
.vw-bin{font-family:'Cascadia Code','Courier New',monospace;font-size:10px;
  color:#7fb0e0;background:#0d1f33;border:1px solid #1f3a5a;border-radius:8px;
  padding:0 5px;margin-left:5px;flex-shrink:0;}

/* Number bar */
.nbar{height:5px;background:#2a2a3a;margin:0 8px 6px;border-radius:3px;overflow:hidden;}
.nbar-f{height:100%;border-radius:3px;background:linear-gradient(90deg,#4ec9b0,#27ae60);
  transition:width .45s cubic-bezier(.4,0,.2,1);}
.nbar-neg{background:linear-gradient(90deg,#c0392b,#e74c3c);}

/* Bool toggle */
.vw-tog{display:flex;align-items:center;gap:5px;margin-left:auto;
  font-family:monospace;font-size:12px;font-weight:700;}
.tog-track{width:30px;height:14px;border-radius:7px;position:relative;
  transition:background .25s;flex-shrink:0;}
.tog-on  .tog-track{background:#27ae60;}
.tog-off .tog-track{background:#c0392b;}
.tog-knob{position:absolute;top:2px;width:10px;height:10px;border-radius:50%;
  background:#fff;transition:left .25s;}
.tog-on  .tog-knob{left:18px;}
.tog-off .tog-knob{left:2px;}
.tog-on  .tog-lbl{color:#4ec9b0;}
.tog-off .tog-lbl{color:#e06c75;}

/* Mini list cells */
.lmini{display:flex;flex-wrap:wrap;gap:3px;padding:2px 8px 7px;background:#131323;}
.lmc{display:flex;flex-direction:column;align-items:center;border-radius:4px;
  overflow:hidden;min-width:34px;max-width:62px;border:1px solid #3b3470;
  animation:pop-cell .2s ease-out both;}
@keyframes pop-cell{
  from{transform:scale(.5) translateY(6px);opacity:0;}
  to  {transform:scale(1) translateY(0);opacity:1;}}
.lmc-i{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;
  font-size:9px;width:100%;text-align:center;padding:1px 0;font-weight:700;}
.lmc-v{font-family:monospace;font-size:11px;padding:2px 4px;color:#ce9178;
  background:#1a1a32;width:100%;text-align:center;overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap;}
.lmc-v.is-num{color:#4ec9b0;}
.lmini-more{align-self:center;color:#555;font-size:11px;padding:0 4px;}

/* Mini dict rows */
.dmini{padding:2px 8px 7px;background:#131313;}
.drow{display:flex;gap:4px;font-family:monospace;font-size:11px;
  padding:1px 0;align-items:center;animation:pop-cell .15s ease-out both;}
.dk{color:#ffd700;}.dsep{color:#555;}.dv{color:#ce9178;}.dv.is-num{color:#4ec9b0;}
.dmini-more{color:#555;font-size:10px;padding:2px 0;}

/* Frame title */
.fgtitle{font-size:11px;font-weight:800;color:#c77dbb;padding:5px 10px 3px;
  display:flex;align-items:center;gap:6px;letter-spacing:.4px;}
.fgtitle-ico{font-size:14px;}
.fgtitle-line{flex:1;height:1px;background:linear-gradient(90deg,#5d2d6b,transparent);}

/* ── Output visualizations ─────────────────────────── */
.out-body{flex:1;overflow-y:auto;padding:5px 6px;
  background:#11111e;color:#d4d4d4;font-family:'Cascadia Code','Courier New',monospace;
  font-size:12px;line-height:1.5;}
.out-empty{color:#444;font-style:italic;padding:14px 10px;font-size:11px;text-align:center;}
.oviz{margin:5px 4px;border-radius:8px;overflow:hidden;border:1px solid #222;
  animation:ov-in .25s cubic-bezier(.16,1,.3,1) both;}
@keyframes ov-in{
  0%{opacity:0;transform:translateY(-8px) scale(.97);}
  60%{transform:translateY(1px) scale(1.01);}
  100%{opacity:1;transform:translateY(0) scale(1);}}
/* Raw label inside card */
.oviz-raw{font-size:10px;color:#444;padding:3px 8px 2px;
  font-family:monospace;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  border-bottom:1px solid #1c1c2a;background:#0d0d1a;}
/* ── Matrix (2D array) grid in output ── */
.omat{display:grid;gap:4px;padding:8px;background:linear-gradient(135deg,#0d1726,#0e0e1c);}
.omat-c{background:#16243a;border:1px solid #2a3f5e;border-radius:5px;
  padding:5px 4px;text-align:center;font-family:'Cascadia Code',monospace;
  font-size:12px;font-weight:700;color:#9fd0ff;
  animation:pop-cell .2s ease-out both;}
.omat-c.omat-pad{background:transparent;border-color:transparent;color:#333;font-weight:400;}
.omat-c-diff{animation:pop-cell .2s ease-out both, cell-flash 1.1s ease-out both;
  border-color:#ffc400!important;color:#ffd23f!important;}
.omat-pre{margin:0;padding:8px;font-family:'Cascadia Code',monospace;font-size:12px;
  color:#9fd0ff;background:#0e0e1c;white-space:pre;overflow:auto;}
/* ── Bitmask 1D bit array (int → binary vector) ── */
.bit-row{display:flex;flex-wrap:wrap;gap:4px;padding:10px 8px;
  background:linear-gradient(135deg,#0d1726,#0e0e1c);}
.bit-c{display:flex;flex-direction:column;align-items:center;min-width:26px;
  border-radius:5px;border:1px solid #2a3f5e;overflow:hidden;
  animation:pop-cell .2s ease-out both;}
.bit-i{font-size:8px;color:#556;padding:1px 4px;background:#0f1a2c;width:100%;text-align:center;}
.bit-v{font-family:'Cascadia Code',monospace;font-weight:800;font-size:15px;
  padding:5px 6px;width:100%;text-align:center;}
.bit-c.bit-on  .bit-v{background:#123d2c;color:#4ec99b;}
.bit-c.bit-off .bit-v{background:#131323;color:#3a3a4a;}
.bit-c.bit-diff{animation:pop-cell .2s ease-out both, cell-flash 1.1s ease-out both;
  border-color:#ffc400!important;}
/* N-dim ndarray in Objects panel: planes & blocks */
.ob-mat-wrap{padding:8px;overflow:auto;}
.ob-mat-wrap-nested{padding:4px 0 0;}
/* Class-instance attribute list (Objects panel) */
.ob-attrs{padding:4px 0;}
.ob-attr-row{padding:6px 10px;border-bottom:1px solid #1a1a2a;}
.ob-attr-k{font-family:monospace;font-size:11px;color:#4ec9b0;margin-bottom:3px;}
.ob-attr-v{padding-left:4px;}
/* ── Bar chart (sorting-visualizer style) for numeric lists ──
   Bars are .ob-cell too, so the FLIP slide (_flipCells) that already
   animates list reorders picks them up automatically — a swap shows as
   two bars physically crossing paths, for any sorting algorithm. */
.bars-wrap{padding:16px 10px 10px;background:linear-gradient(135deg,#0d1726,#0e0e1c);overflow-x:auto;}
.bars-row{display:flex;align-items:flex-end;gap:6px;min-height:150px;position:relative;padding-top:22px;}
.bar-cell{display:flex;flex-direction:column;align-items:center;justify-content:flex-end;
  min-width:28px;flex:1 1 0;max-width:52px;position:relative;
  animation:ob-pop .22s ease-out both;}
.bar-val{font-family:'Cascadia Code',monospace;font-size:11px;color:#9fd0ff;
  margin-bottom:3px;font-weight:700;}
.bar-fill{width:100%;border-radius:4px 4px 0 0;min-height:4px;
  background:linear-gradient(180deg,#4ec9b0,#2a8f77);transition:height .3s ease;}
.bar-cell.bar-neg .bar-fill{background:linear-gradient(180deg,#e0736b,#a13c36);}
.bar-idx{font-size:9px;color:#556;margin-top:4px;}
.bar-cell.bar-active .bar-fill{background:linear-gradient(180deg,#ffc400,#c98600);
  box-shadow:0 0 12px rgba(255,196,0,.55);}
.bar-cell.bar-active .bar-val{color:#ffd23f;}
.bar-claw{position:absolute;top:-4px;left:50%;transform:translateX(-50%);
  color:#ffc400;font-size:15px;line-height:1;text-shadow:0 0 6px rgba(255,196,0,.7);
  animation:ptr-bob .55s ease infinite alternate;}
.bars-sorted{margin:12px 0 4px;text-align:center;color:#4ec99b;font-weight:800;
  font-size:13px;letter-spacing:.5px;text-shadow:0 0 12px rgba(78,201,155,.6);
  animation:ob-pop .3s ease-out both;}
/* ── Bins/groups view (partition search — e.g. días in a scheduling
   problem): one column per group, chips FLIP-slide between columns when
   the algorithm moves an item — same idea as the sort bars, generalized
   to grouped data instead of a single flat array. ── */
.bins-wrap{padding:14px 10px;background:linear-gradient(135deg,#0d1726,#0e0e1c);overflow-x:auto;}
.bins-row{display:flex;gap:10px;align-items:flex-start;}
.bin-col{display:flex;flex-direction:column;min-width:76px;flex:0 0 auto;position:relative;padding-top:14px;}
.bin-hdr{font-size:10px;color:#9b8fff;font-weight:700;margin-bottom:5px;text-align:center;
  font-family:'Cascadia Code',monospace;}
.bin-cnt{color:#666;font-weight:400;}
.bin-body{display:flex;flex-direction:column-reverse;align-items:center;gap:4px;
  padding:6px 4px;border-radius:6px;border:1px dashed #2a3f5e;background:rgba(40,60,90,.1);
  transition:border-color .2s,box-shadow .2s;}
.bin-chip{background:#1a1542;border:1px solid #3b3470;border-radius:5px;
  padding:4px 8px;font-family:'Cascadia Code',monospace;font-size:11px;font-weight:700;
  color:#9fd0ff;min-width:22px;text-align:center;animation:ob-pop .2s ease-out both;}
.bin-empty{font-size:9px;color:#444;font-style:italic;padding:4px;}
.bin-col.bin-active .bin-hdr{color:#ffd23f;}
.bin-col.bin-active .bin-body{border:1px solid #ffc400;border-style:solid;
  box-shadow:0 0 12px rgba(255,196,0,.4);}
.omat-plane{margin:0 0 8px;border-left:2px solid #2a3f5e;padding-left:6px;}
.omat-block{margin:0 0 12px;border:1px solid #2a3f5e;border-radius:6px;
  padding:6px;background:rgba(40,60,90,.12);}
.omat-lbl{font-size:10px;color:#7fb0e0;font-family:'Cascadia Code',monospace;
  margin:0 0 4px;font-weight:700;letter-spacing:.3px;}
.omat-lbl-b{color:#c77dbb;font-size:11px;margin-bottom:6px;}
.oviz-type{display:inline-block;font-size:8px;font-weight:800;padding:1px 5px;
  border-radius:10px;margin-right:4px;vertical-align:middle;}
/* ── Number display ── */
.oviz-num{background:linear-gradient(135deg,#0d1a2e,#0e0e1c);padding:8px 10px 6px;}
.oviz-numval{font-size:26px;font-weight:800;font-family:monospace;
  animation:num-pop .3s ease-out;}
@keyframes num-pop{0%{transform:scale(1.3);opacity:.4}100%{transform:scale(1);opacity:1}}
.oviz-numbar{height:6px;border-radius:3px;margin-top:5px;
  background:linear-gradient(90deg,#667eea,#c77dbb);
  transition:width .5s cubic-bezier(.16,1,.3,1);}
/* ── Bool display ── */
.oviz-bool{padding:7px 10px;display:flex;align-items:center;gap:8px;}
.oviz-bool-dot{width:16px;height:16px;border-radius:50%;flex-shrink:0;}
.oviz-bool-lbl{font-size:18px;font-weight:800;font-family:monospace;}
/* ── String / text ── */
.oviz-text{padding:7px 10px;background:#0f0f1e;}
.oviz-textval{font-size:13px;color:#ce9178;word-break:break-all;}
/* ── Bar chart (list of numbers) ── */
.oviz-bars{background:#0c0c1c;padding:6px 8px 22px;
  display:flex;align-items:flex-end;gap:3px;min-height:70px;position:relative;}
.ovb-col{flex:1;display:flex;flex-direction:column;align-items:center;position:relative;}
.ovb-bar{width:100%;border-radius:3px 3px 0 0;min-height:3px;
  transition:height .5s cubic-bezier(.16,1,.3,1);
  animation:bar-rise .4s cubic-bezier(.16,1,.3,1) both;}
@keyframes bar-rise{from{transform:scaleY(0);transform-origin:bottom}to{transform:scaleY(1)}}
.ovb-lbl{position:absolute;bottom:-18px;font-size:8px;color:#666;
  font-family:monospace;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.ovb-val{position:absolute;top:-14px;font-size:8px;font-family:monospace;color:#aaa;}
/* ── Horiz bar chart (dict/numbers) ── */
.oviz-hbars{background:#0c0c1c;padding:6px 8px;}
.ovhb-row{display:flex;align-items:center;gap:5px;margin-bottom:3px;
  animation:ov-in .22s ease-out both;}
.ovhb-key{min-width:52px;max-width:80px;overflow:hidden;text-overflow:ellipsis;
  font-size:10px;color:#f0c060;font-family:monospace;text-align:right;flex-shrink:0;}
.ovhb-track{flex:1;height:14px;background:#18182a;border-radius:7px;overflow:hidden;position:relative;}
.ovhb-fill{height:100%;border-radius:7px;
  transition:width .5s cubic-bezier(.16,1,.3,1);
  animation:hbar-grow .45s cubic-bezier(.16,1,.3,1) both;}
@keyframes hbar-grow{from{width:0!important}to{}}
.ovhb-val{font-size:10px;color:#4ec9b0;font-family:monospace;min-width:28px;flex-shrink:0;}
/* ── List of strings ── */
.oviz-chips{background:#0c0c1c;padding:6px 8px;display:flex;flex-wrap:wrap;gap:4px;}
.oviz-chip{padding:2px 7px;border-radius:12px;font-size:11px;font-family:monospace;
  border:1px solid #3b3470;color:#c3b1e1;background:#181430;
  animation:ov-in .2s ease-out both;}
.oviz-chip-idx{font-size:9px;color:#555;margin-right:3px;}
/* ── Mixed / fallback ── */
.oviz-fallback{padding:6px 10px;background:#0e0e1e;}
.oviz-falltext{font-size:12px;color:#aaa;word-break:break-all;font-family:monospace;}
/* ── Set display ── */
.oviz-set{background:#0c0c1c;padding:6px 8px;display:flex;flex-wrap:wrap;gap:4px;}
.oviz-setitem{padding:2px 8px;border-radius:12px;font-size:11px;font-family:monospace;
  border:1px solid #3a6060;color:#4ec9b0;background:#0d2020;
  animation:ov-in .2s ease-out both;}

@keyframes run-pulse{
  0%,100%{box-shadow:0 0 0 0 rgba(56,138,52,.7);}
  60%    {box-shadow:0 0 0 7px rgba(56,138,52,0);}}
.btn-run-pulse{animation:run-pulse 1.4s ease-in-out infinite!important;}

@keyframes banner-in{
  from{opacity:0;transform:scaleY(0);}
  to  {opacity:1;transform:scaleY(1);}}
.run-banner{
  background:#1e3a1e;border-bottom:2px solid #388a34;
  padding:7px 14px;font-size:12px;color:#7ec87e;
  display:flex;align-items:center;gap:10px;
  animation:banner-in .25s ease-out;flex-shrink:0;cursor:pointer;}
.run-banner:hover{background:#254225;}
.run-banner b{color:#a0d8a0;}
.run-banner .kb{background:rgba(255,255,255,.1);padding:1px 6px;border-radius:3px;font-family:monospace;font-size:11px;}
</style>
</head>
<body>
<div class="root">

<!-- ── Header ── -->
<header>
  <span class="hbrand">🐍 Python Debugger</span>
  <select class="hsel" id="exSel" onchange="loadEx()">
    <optgroup label="S00 · Intro y tipos">
      <option value="0">Variables y tipos</option>
      <option value="1">Strings y slicing</option>
      <option value="2">Operadores</option>
    </optgroup>
    <optgroup label="S01 · Colecciones">
      <option value="3">Lista, Tupla, Set, Dict</option>
    </optgroup>
    <optgroup label="S02 · Control de flujo">
      <option value="4">if / elif / else</option>
      <option value="5">while, for, enumerate</option>
      <option value="6">for: listas, strings y range</option>
      <option value="7">for: diccionarios, zip y desempaquetado</option>
    </optgroup>
    <optgroup label="S03 · Comprehensions">
      <option value="8">List y Dict comprehension</option>
      <option value="9">Filtrar vs transformar</option>
      <option value="10">if/elif/else como expresion</option>
    </optgroup>
    <optgroup label="S04 · Excepciones">
      <option value="11">try / except / else / finally</option>
    </optgroup>
    <optgroup label="S05 · Funciones">
      <option value="12">Funciones con anotaciones</option>
      <option value="13">*args y **kwargs</option>
      <option value="14">Lambda, recursion, closure</option>
    </optgroup>
    <optgroup label="S06 · OOP">
      <option value="15">Clases y objetos</option>
      <option value="16">Herencia y polimorfismo</option>
      <option value="17">@property y @staticmethod</option>
      <option value="18">Clases abstractas (ABC)</option>
    </optgroup>
    <optgroup label="S07 · Estructuras de datos">
      <option value="19">Stack, Queue, Heap</option>
      <option value="20">Grafos y BFS</option>
    </optgroup>
    <optgroup label="S08 · Funcional">
      <option value="21">map / filter / reduce</option>
    </optgroup>
    <optgroup label="S09 · Generadores">
      <option value="22">yield y next</option>
    </optgroup>
    <optgroup label="S10 · NumPy">
      <option value="23">NumPy · Arrays basicos</option>
      <option value="24">NumPy · Indexado y slicing</option>
      <option value="25">NumPy · Broadcasting y stats</option>
      <option value="26">NumPy · Algebra lineal</option>
    </optgroup>
    <optgroup label="S11 · Pandas">
      <option value="27">Pandas · Series</option>
      <option value="28">Pandas · DataFrame</option>
      <option value="29">Pandas · groupby y apply</option>
      <option value="30">Pandas · merge</option>
    </optgroup>
    <optgroup label="S05 · Archivos">
      <option value="31">Archivos con io.StringIO</option>
      <option value="32">CSV en memoria</option>
    </optgroup>
    <optgroup label="S07 · TDD">
      <option value="33">Tests con assert</option>
    </optgroup>
    <optgroup label="S10 · +Pandas">
      <option value="34">Correlaciones</option>
      <option value="35">Nulos y limpieza</option>
      <option value="36">Pivot table</option>
      <option value="37">Strings en Pandas</option>
    </optgroup>
    <optgroup label="S11 · Visualizacion">
      <option value="38">Datos para graficos</option>
    </optgroup>
    <optgroup label="S13 · Generadores avanzados">
      <option value="39">Generator expressions</option>
      <option value="40">Pipeline de generadores</option>
    </optgroup>
    <optgroup label="S14 · NLP">
      <option value="41">NLP sin NLTK</option>
    </optgroup>
    <optgroup label="S15 · Machine Learning">
      <option value="42">KNN desde cero (ML)</option>
    </optgroup>
    <optgroup label="S16 · Imagenes">
      <option value="43">Imagenes con NumPy</option>
    </optgroup>
    <optgroup label="🎓 Práctica 1 (examen final)">
      <option value="44">P1 · 01 FRange (iterativo)</option>
      <option value="45">P1 · 01 FRange (con range)</option>
      <option value="46">P1 · 02 Ciudades en Florida</option>
      <option value="47">P1 · 03 RLE (iterativo)</option>
      <option value="48">P1 · 03 RLE (recursivo)</option>
    </optgroup>
    <optgroup label="🎓 Práctica 2 (examen final)">
      <option value="49">P2 · 01 sort_by (generador)</option>
      <option value="50">P2 · 02 categorizar (np.where)</option>
      <option value="51">P2 · 03 pivot_table</option>
    </optgroup>
    <optgroup label="🎓 Práctica 3 (examen final)">
      <option value="52">P3 · 01 Pinguinos - Exploracion</option>
      <option value="53">P3 · 02 Pinguinos - NumPy</option>
      <option value="54">P3 · 03 Pinguinos - Limpieza y nueva columna</option>
      <option value="55">P3 · 04 Titanic - Exploracion</option>
      <option value="56">P3 · 05 Titanic - NumPy</option>
      <option value="57">P3 · 06 Titanic - Limpieza y nueva columna</option>
    </optgroup>
  </select>
  <span class="hhint">Space=Paso · Backspace=Atrás · Ctrl+Enter=Run · Ctrl+B=Breakpoint</span>
</header>

<!-- ── Modo Maestro: temario guiado, progreso persistente ── -->
<div id="masterBar" class="master-bar" style="display:none">
  <div class="master-top">
    <span class="master-title" id="masterTitle">🎓 Modo Maestro Py</span>
    <div class="master-progress-track"><div class="master-progress-fill" id="masterFill"></div></div>
    <span class="master-pct" id="masterPct">0%</span>
    <button class="master-btn" onclick="_masterToggleChecklist()" title="Ver todo el temario">☰ Temario</button>
    <button class="master-btn" onclick="_toggleSelfExplain('py')" title="Autoexplícate: ¿por qué se usa esto aquí? (no se califica, es opcional)">🧠 Autoexplícate</button>
    <button class="master-btn" id="mPrev" onclick="masterPrev()" title="Volver al tema anterior">⏮ Anterior</button>
    <button class="master-btn" id="mRepeat" onclick="masterRepeat()" title="Reiniciar la traza de este tema">🔁 Repetir</button>
    <button class="master-btn master-btn-next" id="mNext" onclick="masterNext()">✅ Entendido, siguiente ▶</button>
    <button class="master-btn master-btn-exit" onclick="exitMasterMode()" title="Salir del modo maestro">✕</button>
  </div>
  <div class="master-checklist" id="masterChecklist" style="display:none"></div>
  <div class="self-explain-block" id="selfExplainPy" style="display:none">
    <p>¿Por qué se usa esta construcción o esta línea aquí, y no otra? (no se califica)</p>
    <textarea id="selfExplainTextPy" placeholder="Escribe tu propia explicación aquí..."></textarea>
  </div>
</div>

<!-- ── Modo Maestro AO: temario guiado de Algoritmos de Optimización ── -->
<div id="masterAoBar" class="master-bar master-bar-ao" style="display:none">
  <div class="master-top">
    <span class="master-title" id="masterAoTitle">🧬 Modo Maestro AO</span>
    <div class="master-progress-track"><div class="master-progress-fill" id="masterAoFill"></div></div>
    <span class="master-pct" id="masterAoPct">0%</span>
    <button class="master-btn" onclick="_aoToggleChecklist()" title="Ver todo el temario de AO">☰ Temario</button>
    <button class="master-btn" onclick="_toggleSelfExplain('ao')" title="Autoexplícate: ¿por qué se usa esto aquí? (no se califica, es opcional)">🧠 Autoexplícate</button>
    <button class="master-btn" id="mPrevAo" onclick="aoPrev()" title="Volver al tema anterior">⏮ Anterior</button>
    <button class="master-btn" id="mRepeatAo" onclick="aoRepeat()" title="Reiniciar la traza de este tema">🔁 Repetir</button>
    <button class="master-btn master-btn-next" id="mNextAo" onclick="aoNext()">✅ Entendido, siguiente ▶</button>
    <button class="master-btn master-btn-exit" onclick="exitMasterAo()" title="Salir del modo maestro AO">✕</button>
  </div>
  <div class="master-checklist" id="masterAoChecklist" style="display:none"></div>
  <div class="self-explain-block" id="selfExplainAo" style="display:none">
    <p>¿Por qué se usa esta técnica o este paso del algoritmo aquí, y no otro? (no se califica)</p>
    <textarea id="selfExplainTextAo" placeholder="Escribe tu propia explicación aquí..."></textarea>
  </div>
  <div class="ao-quiz-block" id="aoQuizBlock">
    <div class="ao-quiz-hdr">🧪 Pregunta rápida de este tema</div>
    <div class="math-body" id="aoQuizQuestion"></div>
    <div id="aoQuizOptions" class="math-options" style="display:none"></div>
    <div id="aoQuizNumericWrap" class="math-numeric-wrap" style="display:none">
      <input type="text" id="aoQuizNumericInput" class="math-numeric-input" placeholder="Ej: 3,14" autocomplete="off">
      <button class="master-btn master-btn-next" onclick="_aoCheckQuizAnswer()">Comprobar</button>
    </div>
    <div id="aoQuizFeedback" class="math-feedback" style="display:none"></div>
    <button class="master-btn" id="aoQuizSolutionBtn" onclick="_aoShowQuizSolution()" style="display:none">Ver solución</button>
    <div id="aoQuizSolutionBody" class="math-body math-solution" style="display:none"></div>
  </div>
</div>

<!-- ── Modo Maestro Matemáticas: temario guiado de 02MIAR (VIU) ── -->
<div id="masterMathBar" class="master-bar master-bar-math" style="display:none">
  <div class="master-top">
    <span class="master-title" id="masterMathTitle">📐 Modo Maestro Matemáticas</span>
    <div class="master-progress-track"><div class="master-progress-fill" id="masterMathFill"></div></div>
    <span class="master-pct" id="masterMathPct">0%</span>
    <button class="master-btn" onclick="_mathToggleChecklist()" title="Ver todo el temario de Matemáticas">☰ Temario</button>
    <button class="master-btn" id="mPrevMath" onclick="mathPrev()" title="Volver al tema anterior">⏮ Anterior</button>
    <button class="master-btn master-btn-exit" onclick="exitMasterMath()" title="Salir del modo">✕</button>
  </div>
  <div class="master-checklist" id="masterMathChecklist" style="display:none"></div>
</div>

<!-- ── Repaso mezclado: sin temario secuencial propio, solo título + salir ── -->
<div id="reviewBar" class="master-bar master-bar-review" style="display:none">
  <div class="master-top">
    <span class="master-title" id="reviewTitle">🔀 Repaso mezclado</span>
    <span class="master-pct" id="reviewCounter"></span>
    <button class="master-btn master-btn-exit" onclick="exitReviewMode()" title="Salir del repaso">✕</button>
  </div>
</div>

<!-- ── Panel de Matemáticas: teoría + pregunta + feedback (sustituye a .main completo) ── -->
<div id="mathPanel" class="math-panel" style="display:none">
  <div class="math-card">
    <div class="ptitle ptitle-exp">📖 Teoría <span id="mathSesionBadge" class="math-badge"></span></div>
    <div class="math-body" id="mathTheoryBody"></div>
    <div class="math-worked-wrap">
      <div class="math-worked-hdr">✏️ Ejemplo ya resuelto</div>
      <div class="math-body math-worked" id="mathWorkedBody"></div>
    </div>
  </div>
  <div class="math-card">
    <div class="ptitle ptitle-out">🧪 Pregunta de examen real</div>
    <div class="math-body" id="mathQuestionBody"></div>
    <div id="mathOptions" class="math-options" style="display:none"></div>
    <div id="mathNumericWrap" class="math-numeric-wrap" style="display:none">
      <input type="text" id="mathNumericInput" class="math-numeric-input" placeholder="Ej: 3,14" autocomplete="off">
      <button class="master-btn master-btn-next" onclick="_mathCheckAnswer()">Comprobar</button>
    </div>
    <div id="mathFeedback" class="math-feedback" style="display:none"></div>
    <div id="mathAiWhyWrap" class="math-aiwhy" style="display:none">
      <div class="math-aiwhy-hdr">🔬 ¿Por qué importa en investigación de IA?</div>
      <div id="mathAiWhyBody"></div>
    </div>
    <button class="master-btn" id="mathSolutionBtn" onclick="_mathShowSolution()" style="display:none">Ver solución paso a paso</button>
    <div id="mathSolutionBody" class="math-body math-solution" style="display:none"></div>
    <div class="self-explain-block" id="mathSelfExplain" style="display:none">
      <button class="master-btn" onclick="_toggleSelfExplain('math')">🧠 Autoexplícate (opcional, no se califica)</button>
      <div id="selfExplainInner" style="display:none">
        <p>¿Por qué la respuesta correcta es correcta, y no las demás opciones?</p>
        <textarea id="selfExplainText" placeholder="Escribe tu propia explicación aquí..."></textarea>
      </div>
    </div>
    <button class="master-btn master-btn-next" id="mathNextBtn" onclick="mathNext()" style="display:none">Siguiente tema ▶</button>
  </div>
</div>

<!-- ── Repaso mezclado: pregunta ponderada por fallos, entre los 3 modos ── -->
<div id="reviewPanel" class="math-panel" style="display:none">
  <div class="math-card" id="reviewEmptyCard" style="display:none">
    <div class="math-body">Completa al menos un tema en cualquier modo (Py, AO o Matemáticas)
    para desbloquear el repaso mezclado.</div>
  </div>
  <div class="math-card" id="reviewQuizCard" style="display:none">
    <div class="ptitle ptitle-out">🧪 <span id="reviewSourceBadge" class="math-badge"></span></div>
    <div class="math-body" id="reviewQuestionBody"></div>
    <div id="reviewOptions" class="math-options" style="display:none"></div>
    <div id="reviewNumericWrap" class="math-numeric-wrap" style="display:none">
      <input type="text" id="reviewNumericInput" class="math-numeric-input" placeholder="Ej: 3,14" autocomplete="off">
      <button class="master-btn master-btn-next" onclick="_reviewCheckAnswer()">Comprobar</button>
    </div>
    <div id="reviewFeedback" class="math-feedback" style="display:none"></div>
    <button class="master-btn" id="reviewSolutionBtn" onclick="_reviewShowSolution()" style="display:none">Ver solución</button>
    <div id="reviewSolutionBody" class="math-body math-solution" style="display:none"></div>
    <button class="master-btn master-btn-next" id="reviewNextBtn" onclick="_reviewNext()" style="display:none">Otro repaso ▶</button>
  </div>
  <div class="math-card" id="reviewPyCard" style="display:none">
    <div class="ptitle ptitle-out">✍️ <span id="reviewPyName"></span></div>
    <div class="math-body">Este tema es de Modo Maestro Py — no tiene una pregunta tipo quiz,
    se abre directo en su propio Reto de código.</div>
    <button class="master-btn master-btn-next" onclick="_reviewOpenPyChallenge()">Abrir Reto ▶</button>
  </div>
</div>

<!-- ── Main (2 columnas: Código | Explicabilidad) ── -->
<div class="main">

<!-- ── Reto de código (Modo Maestro): escribe tú la sesión, con editor CodeMirror ──
     Vive dentro de .main (que ya excluye header/master-bar/ctrl) y se ancla al lado
     derecho con position:absolute, ocupando exactamente el mismo alto/ancho que el
     panel de explicabilidad (.p-right) al que tapa mientras el Reto está abierto. -->
<div id="challengeModal" class="challenge-overlay" style="display:none">
  <div class="challenge-card">
    <div class="challenge-hdr">
      <span>✍️ Reto: <span id="challengeTopic"></span></span>
      <button class="master-btn master-btn-exit" onclick="closeChallenge()" title="Cancelar">✕</button>
    </div>
    <p class="challenge-prompt" id="challengePrompt"></p>
    <div class="challenge-editor-wrap"><textarea id="challengeTextarea"></textarea></div>
    <div class="challenge-status" id="challengeStatus"></div>
    <div class="challenge-diff" id="challengeDiff" style="display:none"></div>
    <div class="challenge-ai" id="challengeAI" style="display:none"></div>
    <div class="challenge-hint" id="challengeHint" style="display:none"></div>
    <div class="challenge-solution" id="challengeSolution" style="display:none"></div>
    <div class="challenge-actions" id="challengeActions">
      <button class="master-btn master-btn-next" id="cBtnProbar" onclick="probarReto()">▶ Probar mi código</button>
      <button class="master-btn" id="cBtnPista" onclick="pistaReto()">💡 Pista</button>
      <button class="master-btn" id="cBtnExplain" onclick="explicarConClaude()" disabled
        title="Le pide a Claude una explicación del último error, solo cuando lo pidas (así no gasta tokens en cada intento)">🤖 Explícamelo</button>
      <button class="master-btn" id="cBtnDebug" onclick="depurarIntento()">🔍 Depurar mi intento</button>
      <button class="master-btn" id="cBtnSaltar" onclick="saltarReto()">⏭ Saltar</button>
    </div>
    <div class="challenge-actions" id="challengePassActions" style="display:none">
      <button class="master-btn master-btn-next" onclick="_masterAdvance()">🎉 Siguiente tema ▶</button>
    </div>
  </div>
</div>

  <!-- ◄ IZQUIERDA: Python 3 — editable Y vista de ejecución ► -->
  <div class="p-code">
    <div class="ptitle ptitle-py" id="pyHdr"><span id="pyHdrTxt">Python 3 · Editando</span>
      <button id="editBtn" class="edit-btn" onclick="editMode()" style="display:none">✏️ Editar código</button>
    </div>
    <div id="runBanner" class="run-banner" style="display:none" onclick="runCode()">
      ⚡ <b>Código listo para depurar</b> — pulsa <span class="kb">▶ Run</span> o <span class="kb">Ctrl+Enter</span> para habilitar los botones de paso
    </div>
